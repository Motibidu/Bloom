{
  "expo": {
    "name": "블룸",
    "slug": "bloom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloom.app",
      "infoPlist": {
        "NSContactsUsageDescription": "아는 분을 찾기 위해 연락처에 접근합니다",
        "NSCameraUsageDescription": "활동 사진 촬영을 위해 카메라에 접근합니다",
        "NSPhotoLibraryUsageDescription": "사진 첨부를 위해 앨범에 접근합니다",
        "NSUserNotificationsUsageDescription": "활동 알림을 받기 위해 알림 권한이 필요합니다"
      }
    },
    "android": {
      "package": "com.bloom.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "webviewUrl": "http://172.30.1.78:5173",
      "eas": {
        "projectId": "4d083002-3b96-4594-b46f-0322a1e04088"
      }
    },
    "plugins": [
      "expo-contacts",
      "expo-image-picker",
      "expo-notifications"
    ]
  }
}
